# --- Printful (server only) ---------------------------------------------
# Private token from https://developers.printful.com/tokens with the
# "View store products", "Manage orders" and "View orders" scopes (plus
# "Manage webhooks" if you run `npm run printful:webhook`).
PRINTFUL_API_TOKEN=
# Only needed when the token is account-level and covers several stores.
PRINTFUL_STORE_ID=
# Optional. Leave empty to sell every synced, non-ignored store product.
# Or list sync product IDs (from `npm run printful:products`) in display order.
PRINTFUL_PRODUCT_IDS=
# "true" = paid orders are confirmed in Printful automatically (Printful
# charges you and starts production). Anything else = orders arrive as
# drafts you confirm in the Printful dashboard. Always draft in Stripe test mode.
PRINTFUL_AUTO_CONFIRM=false
# Random string; the Printful webhook URL carries it as ?token=...
PRINTFUL_WEBHOOK_SECRET=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# "true" turns on Stripe Tax for checkout (requires Stripe Tax set up in the dashboard).
STRIPE_AUTOMATIC_TAX=false

# --- Storefront -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://scottsbakeshop.com
# Comma-separated ISO country codes you ship to.
SHIP_COUNTRIES=US
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
